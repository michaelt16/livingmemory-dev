# =============================================================================
# Living Memory — Environment Variables (Amazon Nova Edition)
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# =============================================================================

# --- AWS Credentials ---------------------------------------------------------
# IAM credentials (required for Nova Sonic + Polly)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Bedrock API Key (alternative auth for Nova Lite + Nova Canvas)
# AWS_BEARER_TOKEN_BEDROCK=

# --- Nova Model IDs (optional — defaults shown) ------------------------------
# NOVA_MODEL_ID=us.amazon.nova-2-lite-v1:0
# NOVA_CANVAS_MODEL_ID=amazon.nova-canvas-v1:0
# NOVA_SONIC_MODEL_ID=amazon.nova-sonic-v2:0

# --- Supabase (required) ----------------------------------------------------
# Used for: auth, database, file storage
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- ElevenLabs (required for voice cloning) ---------------------------------
# Used for: voice cloning, narration with cloned voices
ELEVENLABS_API_KEY=

# --- Google Gemini (only for VEO 3 animation) --------------------------------
# Used for: VEO 3 photo animation (kept as third-party integration)
GEMINI_API_KEY=

# --- xAI / Grok (optional — alternative animation) --------------------------
# Used for: Grok Imagine animation engine (alternative to VEO 3)
XAI_API_KEY=

# --- App Config (optional) ---------------------------------------------------
NEXT_PUBLIC_BASE_URL=
